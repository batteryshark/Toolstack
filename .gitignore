__pycache__/
*.py[cod]
.DS_Store
.pytest_cache/
.venv/
build/
dist/
*.egg-info/

# local dev secrets (never commit)
secrets.toml

# one-box Docker deploy: local env (password/passphrase) + runtime state volume
deploy/docker/.env
deploy/docker/data/

# Swift / SwiftPM build artifacts (macapp/, the native operator app)
.build/
.swiftpm/

# Per-tool client skills ship with each tool, not with this repo. The generic
# client skill at client/SKILL.md is tracked.
client/skills/

# Per-tool runtime logs written by the toolyard process runner (<tool>/logs/tool.log).
tools/*/logs/

# Generated test and render output.
admin/tests/evidence/
macapp/evidence/
docs/ui-directions/evidence/
tests/release/evidence/
