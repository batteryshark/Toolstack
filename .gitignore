__pycache__/
*.py[cod]
.DS_Store
# brv context-tool working state: local only (like .ordna / tasks), not repo content.
.brv/
.pytest_cache/
.venv/
build/
dist/
*.egg-info/
/target

# Local-only, not part of the deliverable: the previous build (porting
# reference) and local Claude Code config/skills.
toolstack-old/
.claude/

# Ordna board for /orchestrate: local-only (Private visibility, chosen at init).
# .claude/ above already covers .claude/worktrees/ used for orchestrate worktrees.
/.ordna/
/tasks/

# local dev secrets (never commit)
secrets.toml

# one-box Docker deploy: local env (password/passphrase) + runtime state volume
deploy/docker/.env
deploy/docker/data/

# Swift / SwiftPM build artifacts (macapp/, the native operator app)
.build/
.swiftpm/

# Per-tool agent skills are tied to private tools, not committed. (The tool
# implementations themselves live outside this repo under
# ~/.local/share/toolstack/tools and are never tracked here.) The generic client
# skill at client/SKILL.md is unaffected.
client/skills/
/toolstack-writeup
/.agents

# Per-tool runtime logs written by the toolyard process runner (<tool>/logs/tool.log).
tools/*/logs/
/.work
