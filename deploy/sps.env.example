# Toolstack Secrets Procurement Service environment file. Referenced by
# toolstack-sps.service. Copy to /etc/toolstack/sps.env (the unit points at
# that path), `chmod 600` it, and fill in. The mode check fails closed until
# the file is exactly mode 0600. Generate SP_SECRET with `python3 -m sps.cli init`.

SP_HOST = "127.0.0.1"
SP_PORT = "8743"
# Non-loopback listeners require an explicit opt-in.
#SP_ALLOW_NONLOOPBACK = "1"
# Maximum UTF-8 bytes in a runtime secret write (positive TOML integer).
#SP_MAX_VALUE_BYTES = 65536
SP_TLS_CERT = "/etc/toolstack/sps.crt"
SP_TLS_KEY = "/etc/toolstack/sps.key"
SP_TLS_CA = "/etc/toolstack/sps-ca.crt"
#SP_SECRET =
SP_AUDIT_LOG = "/var/lib/toolstack/audit/sps.audit"

# Choose exactly one plugin.
SP_PLUGIN = "localfile"

[localfile]
# Path to encrypted vault. Initialize/provision offline with SPS stopped.
VAULT_FILE = "/var/lib/toolstack/sps.vault.json"

# OR for Infisical:
#SP_PLUGIN = "infisical"
#[infisical]
#HOST = "https://infisical.example.com"
#VAULT = "ToolServer"
#ENVIRONMENT = "prod"
#CLIENT_ID =
#CLIENT_SECRET =

# OR for Hashicorp Vault:
#SP_PLUGIN = "hashicorp_vault"
#[hashicorp_vault]
#URL = "https://vault.example.com"
#TOKEN =
#MOUNT = "secret"

# Passphrase for the localfile plugin -- read from env (NOT this file, so
# the passphrase never sits in the same mode-0600 file as SP_SECRET).
#SP_VAULT_PASSPHRASE =
# ...or:
#SP_VAULT_PASSPHRASE_FILE = /etc/toolstack/sps.vault.passphrase
# Use an owner-owned mode-0600 file in a mode-0700 parent; canonical path, no links.

# Optional exact backend items beyond each tool's own id. Keep after all
# top-level settings and outside plugin tables; no wildcard expansion.
#[grants]
#my_tool = ["shared-service", "team/provider-path"]
