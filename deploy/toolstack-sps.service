[Unit]
Description=Toolstack Secrets Procurement Service (SPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toolstack
Group=toolstack
# EDIT: absolute path to the Toolstack checkout (same root as the ExecStart line below).
WorkingDirectory=/opt/toolstack
EnvironmentFile=-/etc/toolstack/sps.env
# EDIT: absolute path to the admin venv's python (install.sh creates it at admin/.venv;
# the SPS plugin runs in the same venv so infisical/cryptography deps are available).
ExecStart=/opt/toolstack/admin/.venv/bin/python -m sps.cli serve --config /etc/toolstack/sps.env
Restart=on-failure
RestartSec=3

StateDirectory=toolstack
Environment=XDG_STATE_HOME=/var/lib
Environment=XDG_CONFIG_HOME=/var/lib

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/toolstack /var/log/toolstack

[Install]
WantedBy=multi-user.target
