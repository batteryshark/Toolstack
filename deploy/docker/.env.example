# Copy to .env (cp .env.example .env) and fill in. Read by docker-compose.yml.
# .env is gitignored — keep your real values out of git.

# Admin login password — REQUIRED. The admin won't serve without it (no default creds).
# Set once on first run; change later with the admin UI or `python -m admin set-password`.
TOOLSTACK_ADMIN_PASSWORD=change-me

# Secret backend the toolyard resolves tool secrets from:
#   vault  — local encrypted file (recommended for a laptop; needs the passphrase below)
#   file   — plaintext dev TOML at /data/... (simplest; not encrypted)
TOOLSTACK_SECRET_BACKEND=vault

# Passphrase that unlocks the local encrypted vault. REQUIRED when SECRET_BACKEND=vault.
# This is what protects your tool secrets at rest — make it strong, don't lose it.
TOOLSTACK_VAULT_PASSPHRASE=change-me-too
