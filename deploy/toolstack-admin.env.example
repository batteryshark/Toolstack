# Toolstack admin panel — environment file (referenced by EnvironmentFile= in
# toolstack-admin.service). Copy to the path the unit points at (default
# /etc/toolstack/admin.env), `chmod 600` it (it can hold secrets), and fill in.
#
# Format: systemd reads plain KEY=VALUE lines — no quoting, no `export`, no shell
# expansion. Everything here is OPTIONAL: with an empty or absent file the panel
# runs with the process runner and the file secret backend. Set what you need.

# --- Toolyard: how tools run and where their secrets come from ---------------
# Runner for tool containers: "process" (dev) or "docker" (production).
#TOOLSTACK_RUNNER=docker
# Secret backend the toolyard resolves tool secrets from: "file" or "infisical".
#TOOLSTACK_SECRET_BACKEND=infisical

# --- File secret backend (only when TOOLSTACK_SECRET_BACKEND=file) -----------
# Dev secrets TOML the toolyard reads. A relative path resolves under WorkingDirectory.
#TOOLSTACK_SECRETS_FILE=secrets.toml

# --- Infisical secret backend (only when TOOLSTACK_SECRET_BACKEND=infisical) -
# Required: your Infisical host. THIS IS A PLACEHOLDER — point it at your own server.
#TOOLSTACK_INFISICAL_HOST=https://infisical.example.com
# Environment slug to read secrets from (default: prod).
#TOOLSTACK_INFISICAL_ENVIRONMENT=prod
# Default vault/project the tools' secrets live in (a tool may override per-secret).
#TOOLSTACK_INFISICAL_VAULT=ToolServer
# Optional organization slug, if your Infisical instance requires it.
#TOOLSTACK_INFISICAL_ORGANIZATION_SLUG=
# Per-item machine-identity creds dir: holds <item>.env files with
# INFISICAL_CLIENT_ID / INFISICAL_CLIENT_SECRET. Default: ~/.config/toolstack/infisical.
#TOOLSTACK_INFISICAL_CREDENTIALS_DIR=

# --- Admin panel knobs (optional) --------------------------------------------
# Login username (default: admin). Set the password with `python -m admin set-password`.
#TOOLSTACK_ADMIN_USERNAME=admin
# Session lifetime in seconds (default: 43200 = 12h).
#TOOLSTACK_ADMIN_SESSION_TTL=43200
# Bind off loopback. The admin fails closed on a non-127.0.0.1 bind unless this is set —
# do so ONLY behind a tunnel/proxy you trust (and set the secure cookie below). The broker
# has the matching TOOLSTACK_BROKER_ALLOW_NONLOOPBACK. Default: loopback-only.
#TOOLSTACK_ADMIN_ALLOW_NONLOOPBACK=1
# Mark the session cookie Secure (the browser sends it only over https). Set this whenever
# the panel is reached over TLS — i.e. always, when bound off loopback. Default: off.
#TOOLSTACK_ADMIN_SECURE_COOKIE=1

# Note: the broker's own run-config (nod approval URL / token / channel, DB path,
# broker port, rate limit) is NOT set here. The admin app persists it to broker.toml
# and you edit it from the dashboard — see admin/broker_config.py.
